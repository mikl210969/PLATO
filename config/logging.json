{
  "level": "INFO",
  "max_file_size_mb": 10,
  "max_backup_files": 5,
  "modules": {
    "__main__": {
      "enabled": true,
      "events": ["SIGNAL_GENERATED", "ORDER_SENT", "ORDER_FILLED", "PLATFORM_STARTED", "PLATFORM_STOPPED", "REGIME_CHANGED"]
    },
    "risk_manager": {
      "enabled": true,
      "events": ["*"]
    },
    "passport_manager": {
      "enabled": true,
      "events": ["*"]
    },
    "order_verifier": {
      "enabled": true,
      "events": ["*"]
    },
    "drift_monitor": {
      "enabled": true,
      "events": ["*"]
    },
    "state_manager": {
      "enabled": true,
      "events": ["*"]
    },
    "lifecycle_manager": {
      "enabled": true,
      "events": ["*"]
    },
    "strategies.wall_fade_v3": {
      "enabled": false,
      "events": []
    },
    "strategies.absorption_v2": {
      "enabled": false,
      "events": []
    },
    "strategies.breakout_v1": {
      "enabled": false,
      "events": []
    },
    "detectors": {
      "enabled": true,
      "events": ["WALL_DETECTED", "SPOOFING_CONFIRMED", "DIVERGENCE_DETECTED"]
    },
    "adapters.binance_ws": {
      "enabled": true,
      "events": ["Connected", "Reconnect", "timeout", "lost"]
    },
    "adapters.binance_rest": {
      "enabled": true,
      "events": ["*"]
    }
  }
}